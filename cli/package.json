{
  "name": "@shipperkit/cli",
  "version": "0.1.0",
  "description": "Control a Shipper instance from your terminal.",
  "license": "MIT",
  "homepage": "https://shipperkit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matyas-toth/shipperkit.git",
    "directory": "cli"
  },
  "keywords": [
    "shipper",
    "self-hosted",
    "deploy",
    "cli"
  ],
  "bin": {
    "shipper": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
