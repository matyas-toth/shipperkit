---
import EditLink from "@astrojs/starlight/components/EditLink.astro";
import LastUpdated from "@astrojs/starlight/components/LastUpdated.astro";
import Pagination from "@astrojs/starlight/components/Pagination.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}/${path}`;
const groups = [
  {
    title: "Start here",
    items: [
      ["Install", link("install/")],
      ["First deploy", link("first-deploy/")],
      ["Move an app", link("move-an-app/")],
      ["Uninstall", link("uninstall/")],
    ],
  },
  {
    title: "Operate",
    items: [
      ["Recovery", link("recovery/")],
      ["Troubleshooting", link("diagnostics/")],
      ["Backups", link("backups/")],
      ["Updates", link("updates/")],
    ],
  },
  {
    title: "Reference",
    items: [
      ["CLI", link("cli/")],
      ["Ports", link("ports/")],
      ["API tokens", link("api-tokens/")],
      ["Instance variables", link("instance-variables/")],
    ],
  },
  {
    title: "Project",
    items: [
      ["GitHub", "https://github.com/matyas-toth/shipperkit"],
      ["Releases", "https://github.com/matyas-toth/shipperkit/releases"],
      ["Security", "https://github.com/matyas-toth/shipperkit/blob/master/SECURITY.md"],
      ["Landing", "/"],
    ],
  },
];
---
<div class="docs-pagination">
  <Pagination />
  <div class="docs-page-meta">
    <EditLink />
    <LastUpdated />
  </div>
</div>
<footer class="docs-site-footer">
  <div class="docs-footer-grid">
    <div class="docs-footer-brand">
      <a href={`${base}/`} aria-label="Shipper documentation home">
        <svg viewBox="0 0 81 81" fill="none" aria-hidden="true">
          <path
            d="m5.46 35.39 24.09 11.16-23.81 13.25c5.84 2.79 11.9 4.14 17.34 4.14 12.15 0 24.03-6.33 32.02-18.18 7.4-11.21 13.77-20.23 20.54-28.74l-70.18 18.37z"
            fill="currentColor"></path>
        </svg>
        <span>Shipper</span>
      </a>
      <p>Self-hosted deployment for the server you own.</p>
    </div>
    {groups.map((group) => (
      <div class="docs-footer-group">
        <h2>{group.title}</h2>
        {group.items.map(([label, href]) => (
          <a href={href}>{label}</a>
        ))}
      </div>
    ))}
  </div>
  <div class="docs-footer-bottom">
    <span>MIT licensed</span>
    <span>Shipper contributors</span>
  </div>
</footer>
