---
// Reliability: built around safe releases, rollback, backups and diagnosis.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, Ctas, FeatureGrid, Heading, Reveal } from "../parts";
import { PipelineWidget, RollbackWidget, BackupWidget, AgentWidget, RouterWidget } from "../widgets";
---

<div class="relative isolate">
  <div class="absolute inset-0 -z-10">
    <Dither client:load src="storm" fade="left" fadeFrom={0.1} fadeTo={0.7} exposure={1.3} saturation={1.1} />
  </div>
  <Nav tone="clear" />
  <section class="wrap grid items-center gap-12 py-20 md:grid-cols-[0.95fr_1.05fr] md:py-32">
    <div>
      <Reveal kind="blur"><h1 class="t-hero">A failed deploy never takes your site down</h1></Reveal>
      <Reveal d={1}><p class="t-lead mt-6 max-w-[500px]">Shipper builds and health checks every release before it takes traffic, keeps the last good one serving, and backs up your data on a schedule.</p></Reveal>
      <Reveal d={2} className="mt-9"><Ctas /></Reveal>
    </div>
    <Reveal kind="scale" d={1}><PipelineWidget client:load /></Reveal>
  </section>
</div>

<section class="wrap grid items-center gap-12 py-20 md:grid-cols-2 md:py-28" id="features">
  <Heading title="Go back in seconds" body="Every healthy release is kept. Restoring one swaps traffic back without a rebuild, and failed builds can never be restored by mistake." />
  <Reveal kind="scale" d={1}><RollbackWidget client:visible /></Reveal>
</section>

<section class="wrap grid items-center gap-12 py-20 md:grid-cols-2 md:py-28">
  <Reveal kind="scale" className="order-2 md:order-1"><RouterWidget client:visible /></Reveal>
  <div class="order-1 md:order-2"><Heading title="No gap during a redeploy" body="The new release starts next to the old one and takes traffic only when it answers its health check." /></div>
</section>

<section class="wrap grid items-center gap-12 py-20 md:grid-cols-2 md:py-28">
  <Heading title="Backups you can actually restore" body="Schedule backups to the server or S3-compatible storage, and restore any of them as a copy before you touch the original." />
  <Reveal kind="scale" d={1}><BackupWidget client:visible /></Reveal>
</section>

<section class="wrap grid items-center gap-12 py-20 md:grid-cols-2 md:py-28">
  <Reveal kind="scale" className="order-2 md:order-1"><AgentWidget client:visible initial="doctor" /></Reveal>
  <div class="order-1 md:order-2"><Heading title="Find out what went wrong" body="shipper doctor reads the failed release, names the check that broke and points you to the setting to change." /></div>
</section>

<section class="wrap border-t border-line py-20 md:py-28">
  <FeatureGrid keys={["deploy", "https", "databases", "library", "teams", "updates"]} />
</section>

<Closing media="storm" />
