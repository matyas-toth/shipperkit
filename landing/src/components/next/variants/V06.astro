---
// Walkthrough: a sticky scroll story from install to handing it to an agent.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, Ctas, Reveal } from "../parts";
import { InstallWidget, PipelineWidget, DomainWidget, DatabaseWidget, BackupWidget, AgentWidget } from "../widgets";

const steps = [
  { id: "install", title: "Install on a fresh server", body: "One command sets up Docker, the proxy and the dashboard on Ubuntu or Debian, on x86-64 or ARM64. Pick your host to see the plan." },
  { id: "deploy", title: "Deploy your first app", body: "Paste a Git URL or upload a folder. Shipper builds it, checks its health and only then sends it traffic. Try breaking the build." },
  { id: "domain", title: "Give it a domain", body: "Point DNS at the server and add the domain. The certificate is issued and renewed for you." },
  { id: "database", title: "Add a database", body: "Create PostgreSQL, MySQL, MariaDB, MongoDB, Redis, ClickHouse or SQLite and copy the connection string into your app." },
  { id: "backups", title: "Protect what matters", body: "Schedule backups to the server or S3-compatible storage and restore any of them as a separate copy." },
  { id: "agent", title: "Hand the routine to your agent", body: "A scoped token lets your coding agent deploy, read logs and diagnose failures without SSH." },
];
---

<Nav />
<section class="relative isolate overflow-hidden border-b border-line">
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 md:inset-y-0 md:left-auto md:right-0 md:h-auto md:w-[58%]">
    <Dither client:load src="valley" fade="left" fadeFrom={0.0} fadeTo={0.55} exposure={1} focus={[0.6, 0.5]} />
  </div>
  <div class="wrap pb-52 pt-16 md:py-36">
    <Reveal kind="blur"><h1 class="t-hero max-w-[640px]">From an empty server to production in six steps</h1></Reveal>
    <Reveal d={1}><p class="t-lead mt-6 max-w-[520px]">Shipper installs in minutes and covers everything after it: builds, domains, databases, backups and automation.</p></Reveal>
    <Reveal d={2} className="mt-9"><Ctas /></Reveal>
  </div>
</section>

<section class="wrap grid gap-12 py-20 md:grid-cols-[300px_1fr] md:gap-20 md:py-28" id="features">
  <aside class="hidden md:block">
    <ol class="sticky top-28 space-y-1" id="story-nav">
      {steps.map((s, i) => (
        <li>
          <a href={`#step-${s.id}`} data-step={s.id} class="group flex items-center gap-4 rounded-[10px] px-3 py-3 text-[15px] text-mute transition-colors duration-500 hover:text-ink data-[active=true]:bg-white/[0.04] data-[active=true]:text-ink">
            <span class="t-mono grid size-7 place-items-center rounded-full border border-line text-[12px] transition-colors duration-500 group-data-[active=true]:border-green/50 group-data-[active=true]:text-green">{i + 1}</span>
            {s.title}
          </a>
        </li>
      ))}
    </ol>
  </aside>
  <div class="space-y-24 md:space-y-40">
    {steps.map((s, i) => (
      <article id={`step-${s.id}`} data-story={s.id} class="scroll-mt-28">
        <Reveal><span class="t-mono text-[13px] text-mute">Step {i + 1}</span></Reveal>
        <Reveal d={1}><h2 class="t-h2 mt-3">{s.title}</h2></Reveal>
        <Reveal d={2}><p class="t-lead mt-4 max-w-[560px] !text-[17px]">{s.body}</p></Reveal>
        <Reveal kind="scale" d={2} className="mt-10">
          {s.id === "install" && <InstallWidget client:visible />}
          {s.id === "deploy" && <PipelineWidget client:visible />}
          {s.id === "domain" && <DomainWidget client:visible />}
          {s.id === "database" && <DatabaseWidget client:visible />}
          {s.id === "backups" && <BackupWidget client:visible />}
          {s.id === "agent" && <AgentWidget client:visible />}
        </Reveal>
      </article>
    ))}
  </div>
</section>

<script>
  const links = new Map([...document.querySelectorAll<HTMLElement>("[data-step]")].map((a) => [a.dataset.step, a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a) => (a.dataset.active = "false"));
        const link = links.get((e.target as HTMLElement).dataset.story);
        if (link) link.dataset.active = "true";
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  document.querySelectorAll("[data-story]").forEach((el) => io.observe(el));
</script>

<Closing media="valley" />
