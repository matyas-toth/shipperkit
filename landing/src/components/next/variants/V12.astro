---
// Quickstart: reads like a product docs home, three steps then doors into the docs.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, Ctas, Heading, Reveal, FeatureIcon, INSTALL, type FeatureKey } from "../parts";
import { StatusWidget } from "../widgets";

const steps = [
  { n: 1, title: "Install", body: "Run the installer on a fresh Ubuntu or Debian server with 1 GiB of RAM.", code: INSTALL },
  { n: 2, title: "Claim the instance", body: "Open the address it prints, paste the setup token and create the first admin account.", code: "Open http://203.0.113.10:8080" },
  { n: 3, title: "Deploy", body: "Paste a Git URL in the dashboard, or deploy the current folder from your terminal.", code: "shipper deploy . --domain store.example.com" },
];
const docs: [FeatureKey, string, string, string][] = [
  ["deploy", "First deploy", "Sources, builds and what Shipper detects", "/docs/first-deploy/"],
  ["https", "Domains and HTTPS", "Aliases, redirects and certificates", "/docs/domains/"],
  ["releases", "Releases and rollbacks", "How a release is checked and restored", "/docs/rollbacks/"],
  ["databases", "Databases", "Engines, connection strings and access", "/docs/databases/"],
  ["backups", "Backups", "Schedules, off-server storage and restores", "/docs/backups/"],
  ["agents", "CLI and tokens", "Deploy tokens, the API and automation", "/docs/tokens/"],
];
---

<Nav />
<section class="wrap grid items-center gap-12 pb-20 pt-16 md:grid-cols-[1.1fr_0.9fr] md:pb-28 md:pt-24">
  <div>
    <Reveal kind="blur"><h1 class="t-hero">Self-hosted deployments, set up in minutes</h1></Reveal>
    <Reveal d={1}><p class="t-lead mt-6 max-w-[520px]">Install Shipper on your server and deploy apps, databases and services with HTTPS, rollbacks and backups.</p></Reveal>
    <Reveal d={2} className="mt-9"><Ctas /></Reveal>
  </div>
  <Reveal kind="scale" d={1} className="relative isolate overflow-hidden rounded-[18px] border border-line p-6 sm:p-8">
    <Dither client:load src="lake" exposure={0.9} focus={[0.5, 0.6]} />
    <div class="relative"><StatusWidget client:load /></div>
  </Reveal>
</section>

<section class="border-y border-line bg-bg-2" id="features">
  <div class="wrap py-20 md:py-28">
    <Heading title="Get started" />
    <ol class="mt-12 grid gap-4 md:grid-cols-3">
      {steps.map((s, i) => (
        <Reveal as="li" d={i} className="flex flex-col rounded-[14px] border border-line bg-bg p-6">
          <span class="t-mono grid size-8 place-items-center rounded-full border border-line-2 text-[13px] text-ink">{s.n}</span>
          <h3 class="t-h3 mt-5">{s.title}</h3>
          <p class="t-body mt-2 flex-1 !text-[15px]">{s.body}</p>
          <button type="button" data-copy={s.code} class="t-mono group mt-6 flex w-full cursor-pointer items-center justify-between gap-3 rounded-[8px] border border-line bg-[#0b0c0c] px-3 py-2.5 text-left text-[12px] text-ink-2 hover:border-white/20">
            <span class="truncate">{s.code}</span>
            <span data-copy-label class="shrink-0 text-mute group-hover:text-ink">Copy</span>
          </button>
        </Reveal>
      ))}
    </ol>
  </div>
</section>

<section class="wrap py-20 md:py-28">
  <Heading title="Read further" />
  <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {docs.map(([k, title, body, href], i) => (
      <Reveal as="li" d={i % 3}>
        <a href={href} class="group flex h-full items-start gap-4 rounded-[14px] border border-line p-5 transition-colors hover:border-white/20 hover:bg-white/[0.02]">
          <span class="grid size-10 shrink-0 place-items-center rounded-[10px] border border-line bg-surface text-ink-2 group-hover:text-ink"><FeatureIcon k={k} /></span>
          <span>
            <span class="block text-[16px] font-medium text-ink">{title}</span>
            <span class="mt-1 block text-[14px] text-mute">{body}</span>
          </span>
        </a>
      </Reveal>
    ))}
  </ul>
</section>

<Closing media="lake" />
