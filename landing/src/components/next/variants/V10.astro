---
// Triptych: three dithered panels for apps, databases and services.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, InstallBar, Ctas, Heading, Reveal, Shot } from "../parts";
import { ServerWidget, LibraryWidget } from "../widgets";

const panels = [
  { media: "clouds", title: "Apps", body: "From Git, a folder, an image, a Dockerfile or Compose, with HTTPS and safe releases." },
  { media: "forest", title: "Databases", body: "PostgreSQL, MySQL, MariaDB, MongoDB, Redis, ClickHouse and SQLite, with backups." },
  { media: "aurora", title: "Services", body: "n8n, Immich, Supabase, Grafana and 360 more from the Service Library." },
];
---

<Nav />
<section class="wrap pt-20 text-center md:pt-28">
  <Reveal kind="blur"><h1 class="t-hero mx-auto max-w-[880px]">Run apps, databases and services on your own server</h1></Reveal>
  <Reveal d={1}><p class="t-lead mx-auto mt-6 max-w-[560px]">One install gives you a dashboard, a CLI and a proxy with automatic HTTPS. Free and MIT licensed.</p></Reveal>
  <Reveal d={2} className="mt-9 flex justify-center"><InstallBar /></Reveal>
  <Reveal d={3} className="mt-4"><Ctas center /></Reveal>
</section>

<section class="wrap pt-20 md:pt-24" id="features">
  <div class="flex flex-col gap-3 md:h-[520px] md:flex-row">
    {panels.map((p, i) => (
      <Reveal kind="scale" d={i} className="group relative isolate min-h-[300px] flex-1 overflow-hidden rounded-[18px] border border-line transition-[flex-grow] duration-700 ease-[var(--ease-out)] md:hover:grow-[1.7]">
        <Dither client:visible src={p.media} fade="bottom" fadeFrom={0.15} fadeTo={0.9} exposure={0.95} />
        <div class="absolute inset-x-6 bottom-6">
          <h2 class="t-h2 !text-[30px]">{p.title}</h2>
          <p class="t-body mt-2 max-w-[340px]">{p.body}</p>
        </div>
      </Reveal>
    ))}
  </div>
</section>

<section class="wrap py-20 md:py-28">
  <Reveal kind="scale"><Shot name="applications" alt="Applications in the Shipper dashboard" /></Reveal>
</section>

<section class="wrap grid items-center gap-12 py-20 md:grid-cols-[0.9fr_1.1fr] md:py-28">
  <Heading title="All of it on one machine" body="A small VPS runs more than you think. Add workloads to this 4 GB server and remove them with a click." />
  <Reveal kind="scale" d={1}><ServerWidget client:visible /></Reveal>
</section>

<section class="wrap py-20 md:py-28">
  <Heading center title="Find a service and deploy it" body="Every template comes with its secrets generated and its volumes set up." />
  <Reveal kind="scale" d={2} className="mt-12"><LibraryWidget client:visible /></Reveal>
</section>

<Closing media="clouds" />
