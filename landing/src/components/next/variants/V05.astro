---
// Bento: compact hero, then one large grid mixing dithered tiles and widgets.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, InstallBar, Reveal } from "../parts";
import { PipelineWidget, DomainWidget, RollbackWidget, DatabaseWidget, AgentWidget, BackupWidget, LOGOS } from "../widgets";

const tile = "flex h-full flex-col gap-5 rounded-[18px] border border-line bg-bg-2 p-5 sm:p-6";
---

<Nav />
<section class="wrap pb-14 pt-20 text-center md:pt-28">
  <Reveal kind="blur"><h1 class="t-hero mx-auto max-w-[820px]">Deploy anything to a server you own</h1></Reveal>
  <Reveal d={1}><p class="t-lead mx-auto mt-6 max-w-[580px]">Apps, databases and 365 self-hosted services, with HTTPS, rollbacks and backups. One command to install.</p></Reveal>
  <Reveal d={2} className="mt-9 flex justify-center"><InstallBar /></Reveal>
</section>

<section class="wrap pb-24" id="features">
  <div class="grid auto-rows-auto gap-4 md:grid-cols-12">
    <Reveal kind="scale" className="relative isolate min-h-[340px] overflow-hidden rounded-[18px] border border-line md:col-span-5 md:row-span-2">
      <Dither client:visible src="forest" fade="bottom" fadeFrom={0.1} fadeTo={0.75} exposure={0.95} />
      <div class="absolute inset-x-6 bottom-6">
        <h2 class="t-h2 !text-[32px]">From commit to HTTPS in one step</h2>
        <p class="t-body mt-3">Push to your branch, and Shipper builds, health checks and promotes the release while the old one keeps serving.</p>
      </div>
    </Reveal>
    <Reveal kind="scale" d={1} className="md:col-span-7"><div class={tile}><h3 class="t-h3">Break it on purpose</h3><PipelineWidget client:visible /></div></Reveal>
    <Reveal kind="scale" d={2} className="md:col-span-7"><div class={tile}><h3 class="t-h3">Go back to any release</h3><RollbackWidget client:visible /></div></Reveal>
    <Reveal kind="scale" className="md:col-span-4"><div class={tile}><h3 class="t-h3">Add a domain</h3><DomainWidget client:visible /></div></Reveal>
    <Reveal kind="scale" d={1} className="md:col-span-4">
      <div class={tile}>
        <h3 class="t-h3">365 services</h3>
        <div class="grid grid-cols-5 gap-2">
          {LOGOS.slice(0, 20).map(([name, file]) => (
            <span class="grid aspect-square place-items-center rounded-[10px] border border-line bg-[#0c0d0d] transition-transform duration-300 hover:-translate-y-0.5" title={name}><img src={`/media/logos/${file}`} alt={name} class="size-6 object-contain" loading="lazy" /></span>
          ))}
        </div>
      </div>
    </Reveal>
    <Reveal kind="scale" d={2} className="relative isolate min-h-[300px] overflow-hidden rounded-[18px] border border-line md:col-span-4">
      <Dither client:visible src="woods" fade="top" fadeFrom={0.38} fadeTo={1} exposure={0.9} />
      <div class="absolute inset-x-6 top-6">
        <div class="font-display text-[56px] font-semibold leading-none tracking-[-0.05em]">$0</div>
        <p class="t-body mt-3 max-w-[260px]">MIT licensed. You pay for the server and nothing else.</p>
      </div>
    </Reveal>
    <Reveal kind="scale" className="md:col-span-6"><div class={tile}><h3 class="t-h3">Databases, ready to connect</h3><DatabaseWidget client:visible /></div></Reveal>
    <Reveal kind="scale" d={1} className="md:col-span-6"><div class={tile}><h3 class="t-h3">Backups that restore as a copy</h3><BackupWidget client:visible /></div></Reveal>
    <Reveal kind="scale" className="md:col-span-12"><div class={`${tile} md:grid md:grid-cols-[0.8fr_1.2fr] md:items-center md:gap-10`}><div><h3 class="t-h2 !text-[32px]">Built for agents</h3><p class="t-body mt-3">The CLI and scoped tokens let a coding agent deploy, read logs and diagnose failures without SSH. Every command has a --json form.</p></div><AgentWidget client:visible /></div></Reveal>
  </div>
</section>

<Closing media="forest" />
