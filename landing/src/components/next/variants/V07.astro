---
// Terminal: leads with the installer itself, then the dashboard and the CLI.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, Shot, FeatureGrid, Heading, Reveal, LINKS } from "../parts";
import { InstallWidget, AgentWidget } from "../widgets";
---

<Nav />
<section class="relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <Dither client:load src="moon" fade="left" fadeFrom={0.15} fadeTo={0.75} exposure={1.05} focus={[0.5, 0.4]} />
  </div>
  <div class="wrap grid items-center gap-12 py-20 md:grid-cols-[0.85fr_1.15fr] md:py-28">
    <div>
      <Reveal kind="blur"><h1 class="t-hero">One command turns a server into a hosting platform</h1></Reveal>
      <Reveal d={1}><p class="t-lead mt-6 max-w-[480px]">Run it on Ubuntu or Debian, on x86-64 or ARM64. The installer sets up Docker, the proxy and the dashboard, then prints the address to open.</p></Reveal>
      <Reveal d={2} className="mt-8 flex flex-wrap gap-3">
        <a href={LINKS.install} class="btn btn-primary">Read the install guide</a>
        <a href={LINKS.github} class="btn btn-ghost">View on GitHub</a>
      </Reveal>
    </div>
    <Reveal kind="scale" d={1}><InstallWidget client:load /></Reveal>
  </div>
</section>

<section class="wrap py-20 md:py-28">
  <Heading center title="Then open the dashboard and deploy" body="Paste a Git URL, upload a folder or pick a service from the library. Shipper builds it and gives it HTTPS." />
  <Reveal kind="scale" d={2} className="mt-14"><Shot name="deploy" alt="Deploying a new application in Shipper" /></Reveal>
</section>

<section class="wrap grid items-center gap-12 py-20 md:grid-cols-[1.1fr_0.9fr] md:py-28">
  <Reveal kind="scale" className="order-2 md:order-1"><AgentWidget client:visible /></Reveal>
  <div class="order-1 md:order-2"><Heading title="Or stay in the terminal" body="The shipper CLI covers deploys, logs, diagnosis and restarts, and every command has a --json form for scripts and coding agents." /></div>
</section>

<section class="wrap border-t border-line py-20 md:py-28" id="features">
  <FeatureGrid keys={["releases", "https", "databases", "library", "backups", "teams"]} boxed={false} />
</section>

<Closing media="moon" />
