---
// Showcase: the dashboard on a dithered frame like the brand images, then each screen.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, InstallBar, Ctas, LogoMarquee, Reveal, Shot, feature, type FeatureKey } from "../parts";

const tour: [FeatureKey, string, string][] = [
  ["deploy", "deploy", "Deploying a new application"],
  ["releases", "releases", "A failed deployment next to the release that is still serving"],
  ["databases", "databases", "A managed MongoDB database"],
  ["backups", "backups", "Backup schedules and history"],
  ["library", "service-library", "The Service Library"],
];
---

<Nav />
<section class="wrap pt-20 text-center md:pt-28">
  <Reveal kind="blur"><h1 class="t-hero mx-auto max-w-[860px]">A clean dashboard for everything on your server</h1></Reveal>
  <Reveal d={1}><p class="t-lead mx-auto mt-6 max-w-[580px]">Deploy, watch and recover your apps, databases and services from one place, on hardware you control.</p></Reveal>
  <Reveal d={2} className="mt-9 flex justify-center"><InstallBar /></Reveal>
  <Reveal d={3} className="mt-4"><Ctas center /></Reveal>
</section>

<section class="mx-auto mt-16 max-w-[1360px] px-4 md:mt-20 md:px-6">
  <Reveal kind="scale" className="relative isolate overflow-hidden rounded-[22px] border border-line p-4 sm:p-10 md:p-16">
    <Dither client:load src="sunset" exposure={0.95} focus={[0.5, 0.55]} />
    <Shot name="applications" alt="Applications in the Shipper dashboard" eager className="relative" />
  </Reveal>
</section>

<section class="py-16"><LogoMarquee /></section>

<section id="features">
  {tour.map(([k, shot, alt], i) => (
    <div class="wrap grid items-center gap-10 py-16 md:grid-cols-[0.7fr_1.3fr] md:gap-16 md:py-24">
      <div class:list={[i % 2 ? "md:order-2" : ""]}>
        <Reveal><span class="t-mono text-[13px] text-mute">0{i + 1}</span></Reveal>
        <Reveal d={1}><h2 class="t-h2 mt-3 !text-[clamp(26px,2.6vw,36px)]">{feature(k).title}</h2></Reveal>
        <Reveal d={2}><p class="t-lead mt-4 !text-[17px]">{feature(k).body}</p></Reveal>
      </div>
      <Reveal kind="scale" d={1} className={i % 2 ? "md:order-1" : ""}><Shot name={shot} alt={alt} /></Reveal>
    </div>
  ))}
</section>

<Closing media="sunset" />
