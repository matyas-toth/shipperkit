---
// Minimal: lots of space, one idea per screen, thin dithered bands between sections.
import Dither from "../Dither";
import Closing from "../Closing.astro";
import { Nav, InstallBar, Shot, FeatureGrid, Heading, Reveal } from "../parts";
import { PipelineWidget } from "../widgets";
---

<Nav />
<section class="wrap flex min-h-[78svh] flex-col items-center justify-center py-24 text-center">
  <Reveal kind="blur"><h1 class="t-hero max-w-[760px]">Deploy to your own server</h1></Reveal>
  <Reveal d={1}><p class="t-lead mx-auto mt-6 max-w-[500px]">Apps, databases and services with HTTPS, rollbacks and backups. Free and open source.</p></Reveal>
  <Reveal d={2} className="mt-10 flex w-full justify-center"><InstallBar size="lg" /></Reveal>
</section>

<div class="relative h-40 md:h-56"><Dither client:visible src="hills" fade="edges" fadeFrom={0.5} fadeTo={1} cell={10} /></div>

<section class="wrap py-24 md:py-36">
  <Heading center title="Everything in one dashboard" />
  <Reveal kind="scale" d={1} className="mt-14"><Shot name="applications" alt="Applications in the Shipper dashboard" /></Reveal>
</section>

<div class="relative h-40 md:h-56"><Dither client:visible src="lake" fade="edges" fadeFrom={0.5} fadeTo={1} cell={10} /></div>

<section class="wrap py-24 md:py-36">
  <Heading center title="Mistakes stay offline" body="A release only takes traffic after it builds and passes its health check. Break the build and see." />
  <Reveal kind="scale" d={2} className="mx-auto mt-14 max-w-[760px]"><PipelineWidget client:visible /></Reveal>
</section>

<div class="relative h-40 md:h-56"><Dither client:visible src="moon" fade="edges" fadeFrom={0.5} fadeTo={1} cell={10} /></div>

<section class="wrap py-24 md:py-36" id="features">
  <div class="mx-auto max-w-[880px]"><FeatureGrid keys={["deploy", "https", "databases", "library", "backups", "agents"]} cols={2} boxed={false} /></div>
</section>

<Closing media="hills" />
