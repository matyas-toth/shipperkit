---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** "article" for blog posts and changelog entries. */
  type?: "website" | "article";
  published?: Date;
  /** Replaces the default SoftwareApplication structured data. */
  schema?: Record<string, unknown>;
}

const {
  title = "ShipperKit: Deploy apps to your own server",
  description = "Shipper turns a Linux server into a hosting platform. Deploy apps, databases and self-hosted services with HTTPS, rollbacks and backups built in.",
  noindex = false,
  type = "website",
  published,
  schema,
} = Astro.props;
const site = Astro.site ?? new URL("https://shipperkit.dev");
const canonical = new URL(Astro.url.pathname, site);
const image = new URL("/og.png", site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Shipper",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  description,
  url: "https://shipperkit.dev/",
  image: image.href,
  license: "https://opensource.org/license/mit",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: ["https://github.com/matyas-toth/shipperkit"],
};
const jsonLd = schema ?? structuredData;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content="Shipper" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="ShipperKit blog" href="/blog/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="ShipperKit changelog" href="/changelog/rss.xml" />
    <meta property="og:site_name" content="Shipper" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shipper self-hosted deployment console" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-[14px] focus:text-black"
    >
      Skip to content
    </a>
    <main id="main">
      <slot />
    </main>
    <script>
      // Eased-out reveals as sections scroll in. Elements opt in with data-reveal.
      const seen = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-in");
            seen.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      const watch = () => document.querySelectorAll("[data-reveal]:not(.is-in)").forEach((el) => seen.observe(el));
      watch();
      // React islands hydrate after this runs, so pick up anything they add.
      new MutationObserver(watch).observe(document.body, { childList: true, subtree: true });

      const labels = new WeakMap<Element, string>();
      document.addEventListener("click", async (event) => {
        const trigger = (event.target as HTMLElement | null)?.closest("[data-copy]");
        if (!trigger) return;
        const value = trigger.getAttribute("data-copy") ?? "";
        const label = trigger.querySelector("[data-copy-label]");
        if (label && !labels.has(trigger)) labels.set(trigger, label.textContent ?? "Copy");
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          return;
        }
        trigger.setAttribute("data-copied", "true");
        if (label) label.textContent = "Copied";
        window.setTimeout(() => {
          trigger.removeAttribute("data-copied");
          if (label) label.textContent = labels.get(trigger) ?? "Copy";
        }, 1600);
      });
    </script>
  </body>
</html>
