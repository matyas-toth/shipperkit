---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  intro?: boolean;
}

const {
  title = "Shipper · Deploy your apps to your own server",
  description = "Install Shipper on the server you already own. Deploy from a repo, folder, image, or Compose file, with HTTPS, logs, rollbacks, backups, and agent access included.",
  image = "/og.png",
  noindex = false,
  intro = false,
} = Astro.props;

// The mark opens into the page on the first visit. Keep this path identical to
// public/shipper.svg so the mask hands off from the pulsing mark without a seam.
const mark = "m5.46 35.39 24.09 11.16-23.81 13.25c5.84 2.79 11.9 4.14 17.34 4.14 12.15 0 24.03-6.33 32.02-18.18 7.4-11.21 13.77-20.23 20.54-28.74l-70.18 18.37z";
const site = Astro.site ?? new URL("https://shipperkit.dev");
const canonical = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Shipper",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux",
  description,
  url: "https://shipperkit.dev/",
  image: imageURL.href,
  license: "https://opensource.org/license/mit",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  sameAs: ["https://github.com/matyas-toth/shipperkit"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050606" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="author" content="Shipper" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:site_name" content="Shipper" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shipper self-hosted deployment console" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL.href} />
    <title>{title}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    {intro && (
      <style is:inline>
        .intro { display: none; }
        html.intro-active .intro { display: block; }
      </style>
      <script is:inline>
        (function () {
          try {
            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
            if (location.pathname !== "/") return;
            var forced = /[?&]intro(?:=|&|$)/.test(location.search);
            if (!forced) {
              if (location.hash) return;
              if (navigator.connection && navigator.connection.saveData) return;
              try {
                if (sessionStorage.getItem("shipper-intro") === "1") return;
              } catch (error) {}
            }
            document.documentElement.classList.add("intro-active");
          } catch (error) {}
        })();
      </script>
    )}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-[14px] focus:text-black"
    >
      Skip to content
    </a>
    {intro && (
      <div class="intro" id="intro" aria-hidden="true">
        <svg class="intro-curtain" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <defs>
            <mask id="intro-hole" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%" style="mask-type:luminance">
              <rect x="0" y="0" width="100%" height="100%" fill="#fff" />
              <path id="intro-hole-path" d={mark} fill="#000" />
            </mask>
          </defs>
          <rect id="intro-field" x="0" y="0" width="100%" height="100%" fill="#111212" />
        </svg>
        <div class="intro-mark" id="intro-mark">
          <svg viewBox="0 0 81 81" xmlns="http://www.w3.org/2000/svg" focusable="false">
            <path d={mark} fill="#fff" />
          </svg>
        </div>
      </div>
    )}
    <div class="page-grain" aria-hidden="true"></div>
    <main id="main">
      <slot />
    </main>
    {intro && (
      <script is:inline define:vars={{ mark }}>
        (function () {
          var root = document.documentElement;
          if (!root.classList.contains("intro-active")) return;
          var intro = document.getElementById("intro");
          var field = document.getElementById("intro-field");
          var hole = document.getElementById("intro-hole-path");
          var markEl = document.getElementById("intro-mark");
          if (!intro || !field || !hole || !markEl) {
            root.classList.remove("intro-active");
            intro && intro.remove();
            return;
          }

          var BOX = 81;
          var CENTER = BOX / 2;
          var ROTATION = 20;
          var PULSE = 1420;
          var REVEAL = 1000;
          var forced = /[?&]intro(?:=|&|$)/.test(location.search);
          var size = parseFloat(window.getComputedStyle(markEl).width) || 160;
          var base = size / BOX;
          var done = false;
          var begun = false;

          function finish() {
            if (done) return;
            done = true;
            root.classList.remove("intro-active");
            intro.remove();
            if (!forced) {
              try {
                sessionStorage.setItem("shipper-intro", "1");
              } catch (error) {}
            }
          }

          function transform(cx, cy, rotation, scale) {
            return "translate(" + cx + " " + cy + ") rotate(" + rotation + ") scale(" + scale + ") translate(" + -CENTER + " " + -CENTER + ")";
          }

          // Grow the hole until the whole viewport sits inside the rotated mark.
          function endScale(cx, cy) {
            try {
              var context = document.createElement("canvas").getContext("2d");
              var shape = new Path2D(mark);
              var width = window.innerWidth;
              var height = window.innerHeight;
              var points = [];
              var columns = 16;
              var rows = 10;
              for (var i = 0; i <= columns; i++) {
                for (var j = 0; j <= rows; j++) {
                  points.push([(width * i) / columns, (height * j) / rows]);
                }
              }
              var radians = (ROTATION * Math.PI) / 180;
              var cos = Math.cos(radians);
              var sin = Math.sin(radians);
              function fits(multiplier) {
                var scale = base * multiplier;
                for (var index = 0; index < points.length; index++) {
                  var dx = points[index][0] - cx;
                  var dy = points[index][1] - cy;
                  if (!context.isPointInPath(shape, (dx * cos + dy * sin) / scale + CENTER, (-dx * sin + dy * cos) / scale + CENTER)) {
                    return false;
                  }
                }
                return true;
              }
              var low = 1;
              var high = 640;
              if (!fits(high)) return base * high;
              for (var step = 0; step < 16; step++) {
                var middle = (low + high) / 2;
                if (fits(middle)) high = middle;
                else low = middle;
              }
              return base * high * 1.04;
            } catch (error) {
              return base * 110;
            }
          }

          function begin() {
            if (begun) return;
            begun = true;
            var cx = window.innerWidth / 2;
            var cy = window.innerHeight / 2;
            var target = endScale(cx, cy);
            markEl.classList.add("is-leaving");
            markEl.style.opacity = "1";
            field.setAttribute("mask", "url(#intro-hole)");
            hole.setAttribute("transform", transform(cx, cy, 0, base));
            var started = performance.now();

            function frame(now) {
              var progress = Math.min(1, (now - started) / REVEAL);
              var eased = 1 - Math.pow(1 - progress, 2);
              hole.setAttribute("transform", transform(cx, cy, ROTATION * eased, base * Math.pow(target / base, eased)));
              markEl.style.opacity = String(progress < 0.03 ? 1 : Math.max(0, 1 - (progress - 0.03) / 0.15));
              field.setAttribute("opacity", progress <= 0.86 ? 1 : Math.max(0, 1 - (progress - 0.86) / 0.14));
              if (progress < 1) window.requestAnimationFrame(frame);
              else finish();
            }
            window.requestAnimationFrame(frame);
          }

          markEl.addEventListener("animationend", function (event) {
            if (event.target === markEl && event.animationName === "intro-pulse") begin();
          });
          var pulse = markEl.getAnimations ? markEl.getAnimations().filter(function (animation) {
            return animation.animationName === "intro-pulse";
          })[0] : null;
          if (pulse && pulse.ready) {
            pulse.ready.then(function () {
              window.setTimeout(begin, PULSE * 0.82);
            });
          } else {
            window.setTimeout(begin, PULSE + 300);
          }
          window.setTimeout(begin, PULSE + 900);
          window.setTimeout(finish, 6000);
        })();
      </script>
    )}
    <script>
      const labels = new WeakMap();

      function fallbackCopy(value: string) {
        const area = document.createElement("textarea");
        area.value = value;
        area.setAttribute("readonly", "true");
        area.style.position = "fixed";
        area.style.opacity = "0";
        document.body.appendChild(area);
        area.select();
        const copy = (document as Document & { execCommand?: (command: string) => boolean }).execCommand;
        copy?.call(document, "copy");
        area.remove();
      }

      document.addEventListener("click", async (event) => {
        const trigger = (event.target as HTMLElement | null)?.closest("[data-copy]") as HTMLElement | null;
        if (!trigger) return;
        const value = trigger.getAttribute("data-copy") ?? "";
        const label = trigger.querySelector("[data-copy-label]") as HTMLElement | null;
        if (label && !labels.has(trigger)) labels.set(trigger, label.textContent ?? "Copy");
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          fallbackCopy(value);
        }
        trigger.setAttribute("data-copied", "true");
        if (label) label.textContent = "Copied";
        window.setTimeout(() => {
          trigger.removeAttribute("data-copied");
          if (label) label.textContent = labels.get(trigger) ?? "Copy";
        }, 1600);
      });
    </script>
  </body>
</html>
