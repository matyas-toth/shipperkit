---
import NextBase from "@/layouts/NextBase.astro";
import { NEXT_VARIANTS } from "@/data/next-variants";

const modules = import.meta.glob("../../components/next/variants/V*.astro", { eager: true }) as Record<string, { default: unknown }>;

export function getStaticPaths() {
  return NEXT_VARIANTS.map((v) => ({ params: { id: v.id }, props: { variant: v } }));
}

const { variant } = Astro.props;
const Variant = modules[`../../components/next/variants/V${variant.id}.astro`]?.default as any;
---

<NextBase noindex title={`Shipper · ${variant.id} ${variant.name}`}>
  {Variant && <Variant />}
</NextBase>
