---
import { render } from "astro:content";
import Page from "@/layouts/Page.astro";
import PageHeader from "@/components/PageHeader.astro";
import { comparisons, formatDate } from "@/lib/content";

export async function getStaticPaths() {
  return (await comparisons()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, rows, sources, checked, description } = entry.data;
const host = (url: string) => new URL(url).host.replace(/^www\./, "") + new URL(url).pathname.replace(/\/$/, "");
---

<Page title={`ShipperKit vs ${name}`} description={description} closing={`Try Shipper on your own server`}>
  <PageHeader title={`ShipperKit vs ${name}`} back={{ label: "Compare", href: "/vs/" }} />
  <section class="wrap pt-12 md:pt-16">
    <div class="overflow-clip rounded-[14px] border border-line md:hidden">
      <div class="sticky top-16 z-10 grid grid-cols-2 gap-4 border-b border-line bg-[#0c0d0d] px-4 py-3 font-display text-[15px] font-semibold text-ink">
        <span>ShipperKit</span>
        <span>{name}</span>
      </div>
      <dl>
        {rows.map((row) => (
          <div class="border-b border-line px-4 py-4 last:border-b-0">
            <dt class="text-[13px] font-medium text-mute">{row.label}</dt>
            <dd class="mt-1.5 grid grid-cols-2 gap-4 text-[14.5px] leading-snug text-ink-2">
              <span>{row.shipper}</span>
              <span>{row.them}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="hidden overflow-x-auto rounded-[14px] border border-line md:block">
      <table class="w-full border-collapse text-left text-[15px]">
        <thead>
          <tr class="border-b border-line bg-white/[0.02]">
            <th scope="col" class="w-[24%] px-5 py-4 font-medium text-mute"><span class="sr-only">Topic</span></th>
            <th scope="col" class="w-[38%] px-5 py-4 font-display font-semibold text-ink">ShipperKit</th>
            <th scope="col" class="w-[38%] px-5 py-4 font-display font-semibold text-ink">{name}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-line last:border-b-0">
              <th scope="row" class="px-5 py-4 align-top font-medium text-ink">{row.label}</th>
              <td class="px-5 py-4 align-top text-ink-2">{row.shipper}</td>
              <td class="px-5 py-4 align-top text-ink-2">{row.them}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <section class="wrap !max-w-[768px] pb-24 pt-14 md:pb-32 md:pt-20">
    <div class="prose"><Content /></div>
    <div class="mt-14 border-t border-line pt-8">
      <h2 class="text-[14px] font-medium text-ink">Sources, checked {formatDate(checked)}</h2>
      <ul class="mt-3 space-y-1.5">
        {sources.map((url) => (
          <li><a href={url} rel="nofollow noopener" class="t-mono text-[13px] text-mute underline decoration-line-2 underline-offset-4 hover:text-ink">{host(url)}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Page>
